{
  "id": "./",
  "name": "SongHub Songbook",
  "short_name": "SongHub",
  "description": "Find song codes, keep favorites, and use the complete songbook offline.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
